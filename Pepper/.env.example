# ====================================================================
# CONFIGURAÇÃO DE CREDENCIAIS DA API PEPPER (PEPPER PAY)
# ====================================================================
# Instruções:
# 1. Copie este arquivo renomeando para .env na raiz do projeto ou na pasta api/
# 2. Preencha com as suas credenciais obtidas no Painel da Pepper
# 3. Mantenha este arquivo protegido contra leitura pública externa

# Token de Autenticação Bearer (Painel Pepper > Configurações > API)
PEPPER_API_TOKEN=

# Segredo de Assinatura do Webhook (Painel Pepper > Configurações > Webhooks)
PEPPER_WEBHOOK_SECRET=

# Identificadores do Produto e Oferta ("E-book de Receitas para Emagrecimento")
# Deixe vazio se for utilizar o script administrativo /api/setup-product.php para cadastrar
PEPPER_PRODUCT_HASH=
PEPPER_OFFER_HASH=

# URL Base Oficial da API Pública Pepper
PEPPER_API_BASE_URL=https://api.cloud.pepperpay.com.br/public/v1

# Valor da Oferta definido no Backend (em centavos: 3582 = R$ 35,82)
PEPPER_DEFAULT_AMOUNT=3582

# URL de Notificação de Webhook (opcional, detectada automaticamente se não preenchida)
# PEPPER_WEBHOOK_URL=https://seudominio.com/api/webhook-pepper.php

# Chave de segurança para executar o script único /api/setup-product.php
PEPPER_ADMIN_SECRET=admin_pepper_setup_2026

# Modo de Teste Simulado (true = simula PIX sem cobranças reais; false = produção real Pepper)
PEPPER_MOCK_MODE=false
